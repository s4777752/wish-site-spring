{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "POST без полей возвращает ошибку",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST с неверной подписью",
      "method": "POST",
      "path": "/",
      "body": {"timestamp": 1, "subtotal": 100, "percentage": 0, "charge_percentage": 0, "charge_fixed": 0, "total": 100, "sign": "invalid"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
